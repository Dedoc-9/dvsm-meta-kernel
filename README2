impl Server {

    pub green: GreenRuntime,

    pub fn tick(&mut self, peer_hashes: Vec<Hash>) -> Option<Hash> {

        self.tick += 1;

        // --------------------------------------------
        // GREEN MODE ADAPTIVE TICKING
        // --------------------------------------------
        let dt = self.green.adapt_tick(TICK_RATE);

        // APPLY COMMANDS (UNCHANGED)
        for cmd in self.buffer.drain(..) {
            match cmd {
                Command::Spawn(id) => self.ecs.add(id),

                Command::Destroy(id) => {
                    if let Some(i) = self.ecs.index(id) {
                        self.ecs.swap_remove(i);
                    }
                }

                Command::SetVel(id, v) => {
                    if let Some(i) = self.ecs.index(id) {
                        self.ecs.vel[i] = v;
                    }
                }
            }
        }

        // PHYSICS STEP (DETERMINISTIC CORE UNCHANGED)
        for i in 0..self.ecs.entities.len() {
            self.ecs.pos[i][0] =
                fx_mul(self.ecs.vel[i][0], 1) / dt;
        }

        // STATE HASH (UNCHANGED TRUTH FUNCTION)
        let hash = s_echo(&self.ecs);

        // ROLLBACK BUFFER (UNCHANGED)
        self.rollback.push(Snapshot {
            tick: self.tick,
            state_hash: hash,
            ecs: self.ecs.clone(),
        });

        // --------------------------------------------
        // CONSENSUS (GREEN ADAPTIVE WINDOW)
        // --------------------------------------------
        let threshold = self.green.adapt_consensus_window(
            self.consensus.threshold
        );

        if peer_hashes.iter().filter(|h| **h == hash).count() < threshold {
            return None;
        }

        // --------------------------------------------
        // ZK VERIFICATION (OPTIONALLY THROTTLED)
        // --------------------------------------------
        let zk_check = self.green.adapt_verification(true);

        if zk_check {
            let zk = ZKProof {
                prev: self.last_hash,
                curr: hash,
                tick: self.tick,
            };

            if !verify_zk(&zk) {
                return None;
            }
        }

        self.last_hash = hash;
        Some(hash)
    }
}
