pub struct GreenRuntime {
    pub spectral_noise: f64,
    pub consensus_stability: f64,
    pub enabled: bool,
}

impl GreenRuntime {

    pub fn evaluate(&mut self, noise: f64, stability: f64) {
        self.spectral_noise = noise;
        self.consensus_stability = stability;

        self.enabled =
            noise < 0.05 &&
            stability > 0.95;
    }

    // --------------------------------------------
    // ADAPTIVE TICK SCALING (DETERMINISTIC SAFE)
    // --------------------------------------------
    pub fn adapt_tick(&self, base_dt: Fx) -> Fx {
        if self.enabled {
            // slower tick = reduced compute density
            base_dt + (base_dt / 2)
        } else {
            base_dt
        }
    }

    // --------------------------------------------
    // VERIFICATION THROTTLING (SAFE REDUCTION ONLY)
    // --------------------------------------------
    pub fn adapt_verification(&self, full_check: bool) -> bool {
        if self.enabled {
            // partial verification allowed ONLY under stability
            full_check && self.spectral_noise < 0.02
        } else {
            full_check
        }
    }

    // --------------------------------------------
    // CONSENSUS WINDOW ADJUSTMENT
    // --------------------------------------------
    pub fn adapt_consensus_window(&self, base: usize) -> usize {
        if self.enabled {
            base + 1 // slightly wider tolerance window
        } else {
            base
        }
    }
}
