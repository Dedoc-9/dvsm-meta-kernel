//     var hash: UInt64
//     var tick: UInt64
// }
//
// func dvsm_step(_ ptr: UnsafeMutableRawPointer, peers: [UInt64]) -> UInt64
//
// ============================================================================


// ============================================================================
// WIRE PROTOCOL (BINARY MODEL)
