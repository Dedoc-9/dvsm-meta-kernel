pub struct Vajra {
    pub anchor: f64,
}

impl Vajra {

    pub fn evaluate(&self, trace: &TraceLog) -> f64 {

        let mut sum = 0.0;

        for v in &trace.values {
            sum += (v - self.anchor).abs();
        }

        sum / (trace.values.len().max(1) as f64)
    }
}

