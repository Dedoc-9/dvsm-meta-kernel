        unsafe {
            let raw = get_external_field_sample(domain_id, seed);
            // Non-linear collapse + pseudo-noise to destroy invertibility
            let obs = (raw / 1.0).atan(); 
            let noise = (seed.sin() * 1000.0).fract() * 1e-4;
            obs + noise
        }
    }
}

