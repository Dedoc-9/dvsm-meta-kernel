// ============================================================================
// OBSERVATION LAYER (DVSM EPISTEMIC INTERFACE)
// ============================================================================

pub struct Observation;

impl Observation {

    pub fn observe_kirsch(
        proj: &KirschProjectionFunctor,
        iteration: u64
    ) -> f64 {

        let theta = Self::sample_theta(iteration);
        proj.apply(theta)
    }

    #[inline(always)]
    fn sample_theta(i: u64) -> f64 {
        // Stateless deterministic "randomization"
        ((i as f64).sin().abs()) * 2.0 * PI
    }
}

// ============================================================================
// TRACE LOG (PURE RESIDUE)
// ============================================================================

pub struct TraceLog {
    pub values: Vec<f64>,
}

impl TraceLog {
    pub fn push(&mut self, v: f64) {
        self.values.push(v);
    }
}

// ============================================================================
// VAJRA (ANCHOR DEVIATION MONITOR)
// ============================================================================

pub struct Vajra {
    pub anchor: f64,
}

impl Vajra {

    pub fn evaluate(&self, trace: &TraceLog) -> f64 {

        let mut sum = 0.0;

        for v in &trace.values {
            sum += (v - self.anchor).abs();
        }

        sum / (trace.values.len().max(1) as f64)
    }
}

