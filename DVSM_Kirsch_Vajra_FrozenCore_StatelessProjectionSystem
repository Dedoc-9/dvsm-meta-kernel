    /// C++ side handles the heavy PDE math (Kirsch or Rayleigh-Plesset)
    fn get_external_field_sample(domain_id: u32, param: f64) -> f64;
}

// ============================================================================
// III. TRACE RESIDUE (STOCHASTIC SINK)
// ============================================================================

pub struct TraceLog<C: CollapseClass> {
    pub values: Vec<f64>,
    _marker: PhantomData<C>,
}

impl<C: CollapseClass> TraceLog<C> {
    pub fn new() -> Self {
        Self { values: Vec::new(), _marker: PhantomData }
    }
}

// ============================================================================
// IV. TYPED VAJRA (THE SEMANTIC FIREWALL)
// ============================================================================

/// Vajra is parameterized by C. 
/// Vajra<Kirsch> and Vajra<Bubble> are different types and cannot be compared.
pub struct Vajra<C: CollapseClass> {
    pub anchor: f64,
    _marker: PhantomData<C>,
}

impl<C: CollapseClass> Vajra<C> {
    pub fn new(anchor: f64) -> Self {
        Self { anchor, _marker: PhantomData }
    }

    /// Evaluates statistical drift relative to the local coordinate origin.
    pub fn evaluate(&self, trace: &TraceLog<C>) -> f64 {
        if trace.values.is_empty() { return 0.0; }
        let sum: f64 = trace.values.iter().map(|v| (v - self.anchor).abs()).sum();
        sum / trace.values.len() as f64
    }
}

// ============================================================================
// V. META-VAJRA (THE TYPED OBSERVER LATTICE)
