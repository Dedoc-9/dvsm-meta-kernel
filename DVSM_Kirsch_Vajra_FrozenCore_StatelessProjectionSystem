pub struct Observation;

impl Observation {

    pub fn observe_kirsch(
        proj: &KirschProjectionFunctor,
        iteration: u64
    ) -> f64 {

        let theta = Self::sample_theta(iteration);
        proj.apply(theta)
    }

    #[inline(always)]
    fn sample_theta(i: u64) -> f64 {
        // Stateless deterministic "randomization"
        ((i as f64).sin().abs()) * 2.0 * PI
    }
}

