pub struct System {
    pub v: V,
    pub sigma: Sigma,
    pub trace: TraceLog,
}

impl System {

    pub fn step(
        &mut self,
        proj: &KirschProjectionFunctor,
        vajra: &Vajra,
        iteration: u64
    ) {

        // 1. Ontic update (internal only)
        self.v = self.v.evolve();

        // 2. Observation (external physics projection only)
        let obs = Observation::observe_kirsch(proj, iteration);
        self.trace.push(obs);

        // 3. Vajra evaluation (statistical only)
        let _drift = vajra.evaluate(&self.trace);
    }
}

