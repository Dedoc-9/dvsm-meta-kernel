pub struct LeakDetector;

#[derive(Debug, Clone)]
pub enum LeakSignature {
    DriftBurst,        // sudden change in variance
    PlateauLock,       // repeated identical values
    EntropySpike,      // high randomness window
    AnchorDeviation,   // sustained distance from anchor
    Undefined,         // fallback non-classification
}

impl LeakDetector {

    // ------------------------------------------------------------------------
    // MAIN ENTRY POINT
    // ------------------------------------------------------------------------
    pub fn analyze(trace: &TraceLog, anchor: f64) -> LeakSignature {

        if Self::detect_plateau(trace) {
            return LeakSignature::PlateauLock;
        }

        if Self::detect_entropy_spike(trace) {
            return LeakSignature::EntropySpike;
        }

        if Self::detect_drift(trace, anchor) {
            return LeakSignature::AnchorDeviation;
        }

        if Self::detect_burst(trace) {
            return LeakSignature::DriftBurst;
        }

        LeakSignature::Undefined
    }

    // ------------------------------------------------------------------------
    // PLATEAU DETECTION
    // ------------------------------------------------------------------------
    fn detect_plateau(trace: &TraceLog) -> bool {
        trace.values
            .windows(2)
            .all(|w| (w[0] - w[1]).abs() < f64::EPSILON)
    }

    // ------------------------------------------------------------------------
    // ENTROPY SPIKE (SIMPLE VARIANCE PROXY)
    // ------------------------------------------------------------------------
    fn detect_entropy_spike(trace: &TraceLog) -> bool {
        let mean = trace.values.iter().sum::<f64>() / trace.values.len().max(1) as f64;

        let var = trace.values.iter()
            .map(|v| (v - mean).powi(2))
            .sum::<f64>() / trace.values.len().max(1) as f64;

        var > 1.0  // threshold is arbitrary, non-semantic
    }

    // ------------------------------------------------------------------------
    // ANCHOR DEVIATION (DVSM-SAFE: NO SEMANTIC INTERPRETATION)
    // ------------------------------------------------------------------------
    fn detect_drift(trace: &TraceLog, anchor: f64) -> bool {
        let avg = trace.values.iter().sum::<f64>() / trace.values.len().max(1) as f64;
        (avg - anchor).abs() > 0.5
    }

    // ------------------------------------------------------------------------
    // BURST DETECTION (LOCAL GRADIENT IRREGULARITY ONLY)
    // ------------------------------------------------------------------------
    fn detect_burst(trace: &TraceLog) -> bool {
        trace.values
            .windows(3)
            .any(|w| {
                let d1 = (w[1] - w[0]).abs();
                let d2 = (w[2] - w[1]).abs();
                d1 > 1.0 && d2 > 1.0
            })
    }
}

