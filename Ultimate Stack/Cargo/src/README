The core.rs execution order becomes extremely clean:

// 1. containment
containment::containment_step(state);

// 2. projection

// 3. lie evolution

// 4. ema

// 5. basis adaptation

// 6. manifold maintenance
manifold::maintain_manifold(state);

// 7. velocity / omega

// 8. ghost classification
ghost::classify(state);

// 9. trace emission
let trace =
    trace::emit_trace(
        state,
        novelty,
    );
