    func emit(_ ir: [IRInstruction]) -> String {
        return ir.map { instr in
            switch instr {
            case .loadInvariant(let h):
                return "LOAD::<\(h)>"
            case .computeStability(let s):
                return "STABILITY::<\(s)>"
            case .bindExecution(let e):
                return "BIND::<\(e)>"
            }
        }.joined(separator: " → ")
