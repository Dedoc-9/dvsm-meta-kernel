enum IRInstruction {
    case load(String)
    case compute(Double)
    case bind(String)
}

struct LLVMIRBuilder {

    func lower(_ invariant: Invariant) -> [IRInstruction] {

        return [
            .load(invariant.hash),
            .compute(invariant.stability),
            .bind("Ξ_EXECUTION")
        ]
    }

    func emit(_ ir: [IRInstruction]) -> String {
        return ir.map { instr in
            switch instr {
            case .load(let h):
                return "LOAD[\(h)]"
            case .compute(let s):
                return "STABILITY[\(s)]"
            case .bind(let b):
                return "BIND[\(b)]"
            }
        }.joined(separator: " → ")
    }
}

