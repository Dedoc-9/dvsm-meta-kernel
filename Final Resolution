// =============================================================================
//
// PURPOSE:
// Validate invariant stability under randomized adversarial perturbation.
//

struct CMSTEngine {

    // Monte Carlo stability simulation
    func monteCarlo(_ invariants: [Invariant], iterations: Int = 50) -> Double {

        guard !invariants.isEmpty else { return 0 }

        var totalVariance: Double = 0

        for _ in 0..<iterations {

            let perturbed = invariants.map { inv in
                Invariant(
                    hash: inv.hash,
                    stability: inv.stability * Double.random(in: 0.7...1.2),
                    weight: inv.weight * Double.random(in: 0.7...1.2)
                )
            }

            let meanOriginal = invariants.map { $0.stability }.reduce(0, +) / Double(invariants.count)
            let meanPerturbed = perturbed.map { $0.stability }.reduce(0, +) / Double(perturbed.count)

            totalVariance += abs(meanOriginal - meanPerturbed)
        }

        return totalVariance / Double(iterations)
    }

    func isStable(_ invariants: [Invariant]) -> Bool {
        let variance = monteCarlo(invariants)
        return variance < 0.25
    }
}

