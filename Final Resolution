    case bindExecution(String)
}

struct SECHOLLVM {

    func lower(hash: InvariantHash, stability: Double) -> [IRInstruction] {

        return [
            .loadInvariant(hash),
            .computeStability(stability),
            .bindExecution("Ξ_EXEC")
