import Foundation

typealias EventID = String
typealias InvariantHash = String

struct Event {
    let id: EventID
    let payload: String
}

struct Invariant {
    let hash: InvariantHash
    let stability: Double
    let weight: Double
}

// =============================================================================
// MARK: - (1) CKITL PARSER LAYER (GRAMMAR FRONTEND)
// =============================================================================
//
// This layer is designed to be replaced with:
//   - ANTLR parser
//   - Tree-sitter grammar
//   - PEG.js frontend
//
// Current implementation = strict deterministic grammar validator
//

struct CKITLParser {

    // Grammar rule:
    // ID : [A-Z0-9_]+ : PAYLOAD : ANY NON-EMPTY STRING
    func parse(_ raw: String) -> Event? {

        let parts = raw.split(separator: ":")

        guard parts.count == 2 else { return nil }

        let id = String(parts[0])
        let payload = String(parts[1])

        guard isValidID(id),
              !payload.trimmingCharacters(in: .whitespaces).isEmpty else {
            return nil
        }

        return Event(id: id, payload: payload)
    }

    private func isValidID(_ id: String) -> Bool {
        let pattern = "^[A-Z0-9_]+$"
        return id.range(of: pattern, options: .regularExpression) != nil
    }
}

// =============================================================================
// MARK: - NORMALIZATION + S_ECHO LAYER (INVARIANT HASH CORE)
// =============================================================================
//
// This simulates LLVM IR lowering preparation stage:
// Event → normalized canonical form → deterministic hash
//

struct SECHO {

    func normalize(_ event: Event) -> String {
        return event.payload
            .trimmingCharacters(in: .whitespacesAndNewlines)
            .lowercased()
    }

    func hash(_ normalized: String) -> InvariantHash {
        return String(normalized.hashValue)
    }

    func lowerToInvariant(_ event: Event) -> Invariant {
        let norm = normalize(event)
        let h = hash(norm)

        return Invariant(
            hash: h,
            stability: Double.random(in: 0.6...1.0),
            weight: Double.random(in: 0.5...1.0)
        )
    }
}

