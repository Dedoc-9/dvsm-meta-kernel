## §3 Adaptive Regime Selection (Dynamic Per-Frame)

### §3.1 Detect Regime from Singularity

```rust
pub fn detect_regime_from_singularity_q31_32(p_zero_q: i64) -> u8 {
    let regime_0_threshold = f32_to_q31_32(0.92);
    let regime_1_threshold = f32_to_q31_32(0.85);
    
    if p_zero_q >= regime_0_threshold {
        0  // LOCKED
    } else if p_zero_q >= regime_1_threshold {
        1  // NOMINAL
    } else {
        2  // SLIPPING
    }
}
```

### §3.2 Select Tile Dimensions

```rust
pub fn select_tile_dimensions_q31_32(p_zero_q: i64) -> (u32, u32) {
    let regime = detect_regime_from_singularity_q31_32(p_zero_q);
    
    match regime {
        0 => (8, 8),      // LOCKED: L1 sprint
        1 => (16, 16),    // NOMINAL: L2 strategy
        _ => (64, 64),    // SLIPPING: DRAM OK
    }
}
```

### §3.3 Select LUT Size

```rust
pub fn select_lut_size_q31_32(p_zero_q: i64) -> usize {
    let regime = detect_regime_from_singularity_q31_32(p_zero_q);
    
    match regime {
        0 => 64,          // LOCKED: L1 fit
        1 => 256,         // NOMINAL: L2 fit
        _ => 512,         // SLIPPING: full alphabet
    }
}
```

### §3.4 Per-Frame Adaptive Config Computation

```rust
pub struct SAECAdaptiveConfig {
    regime: u8,
    p_zero_q: i64,           // P(ε=0) in Q31.32
    tile_width: u32,
    tile_height: u32,
    lut_size: usize,
    compression_target_ratio: f32,
}

pub fn compute_adaptive_config(
    phase_delta_q: i64,
) -> SAECAdaptiveConfig {
    // 1. Compute singularity probability
    let p_zero_q = compute_singularity_probability_q31_32(phase_delta_q);
    
    // 2. Detect regime
    let regime = detect_regime_from_singularity_q31_32(p_zero_q);
    
    // 3. Select tile and LUT from regime
    let (tile_width, tile_height) = select_tile_dimensions_q31_32(p_zero_q);
    let lut_size = select_lut_size_q31_32(p_zero_q);
    
    // 4. Set compression target based on regime
    let compression_target_ratio = match regime {
        0 => 0.90,  // Regime 0: aim for 90% compression
        1 => 0.70,  // Regime 1: aim for 70%
        _ => 0.45,  // Regime 2: aim for 45%
    };
    
    SAECAdaptiveConfig {
        regime,
        p_zero_q,
        tile_width,
        tile_height,
        lut_size,
        compression_target_ratio,
    }
}
```

