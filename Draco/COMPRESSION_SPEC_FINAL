## §4 Adaptive Encoding Loop (Tile-Based, Singularity-Gated)

### §4.1 Encoder State (Per-Frame)

```rust
pub struct SAECEncoderAdaptive {
    // Coder state
    low: u64,
    high: u64,
    pending_bits: i32,
    output: BitWriter,
    
    // Adaptive config (recomputed each frame)
    config: SAECAdaptiveConfig,
    
    // Probability tables (regime-specific)
    lut: Vec<u32>,  // Dynamic size: 64, 256, or 512
    
    // Statistics
    tiles_encoded: u32,
    total_symbols: u64,
    total_bits: u64,
}

impl SAECEncoderAdaptive {
    pub fn new(phase_delta_q: i64) -> Self {
        let config = compute_adaptive_config(phase_delta_q);
        let lut = allocate_lut_for_regime(config.regime);
        
        Self {
            low: 0,
            high: 0xFFFFFFFFFFFFFFFF,
            pending_bits: 0,
            output: BitWriter::new(),
            config,
            lut,
            tiles_encoded: 0,
            total_symbols: 0,
            total_bits: 0,
        }
    }
}
```

### §4.2 Tile-Based Encoding (Main Loop)

```rust
pub fn encode_observation_frame_adaptive(
    encoder: &mut SAECEncoderAdaptive,
    observation: &[f32],  // Full frame (e.g., 1920×1080×3)
    width: usize,
    height: usize,
) -> Result<Vec<u8>, String> {
    // Frame header
    encoder.output.write_bits(0xABCD, 16);  // Sync
    encoder.output.write_bits(encoder.config.regime as u32, 2);
    encoder.output.write_bits((width * height) as u32, 32);
    
    // Tile-based encoding loop
    let (tile_w, tile_h) = (encoder.config.tile_width, encoder.config.tile_height);
    
    for tile_y in (0..height).step_by(tile_h as usize) {
        for tile_x in (0..width).step_by(tile_w as usize) {
            // Extract tile
            let tile_data = extract_tile(
                observation,
                tile_x,
                tile_y,
                width,
                tile_w as usize,
                tile_h as usize,
            );
            
            // Encode tile residuals
            encode_tile_residuals(
                encoder,
                &tile_data,
                tile_w as usize,
                tile_h as usize,
            )?;
            
            encoder.tiles_encoded += 1;
        }
    }
    
    // Finalize coder
    finalize_arithmetic_coder(encoder);
    
    Ok(encoder.output.flush())
}

fn encode_tile_residuals(
    encoder: &mut SAECEncoderAdaptive,
    tile: &[f32],
    tile_w: usize,
    tile_h: usize,
) -> Result<(), String> {
    // Predict tile using Rose MLP (frozen weights)
    let mut predicted = vec![0.0; tile.len()];
    // [prediction code omitted for brevity]
    
    // Compute residuals
    for i in 0..tile.len() {
        let eps = tile[i] - predicted[i];
        let eps_q = (256.0 * eps).round() as i32;
        let symbol = eps_q.clamp(-256, 255);
        
        encode_symbol(encoder, symbol)?;
        encoder.total_symbols += 1;
    }
    
    Ok(())
}

fn encode_symbol(
    encoder: &mut SAECEncoderAdaptive,
    symbol: i32,
) -> Result<(), String> {
    if symbol < -256 || symbol > 255 {
        return Err(format!("Symbol {} out of range", symbol));
    }
    
    // Clamp to valid LUT range
    let lut_idx = ((symbol + 256) as usize) % encoder.lut.len();
    
    let range_low = encoder.lut[lut_idx] as u64;
    let range_high = if lut_idx + 1 < encoder.lut.len() {
        encoder.lut[lut_idx + 1] as u64
    } else {
        0xFFFFFFFF
    };
    
    // Arithmetic encoding (standard loop, from SAEC_PROBABILITY_MODEL.md)
    let range = encoder.high.saturating_sub(encoder.low) + 1;
    let scaled_low = encoder.low + ((range * range_low) >> 32);
    let scaled_high = encoder.low + ((range * range_high) >> 32);
    
    encoder.high = scaled_high;
    encoder.low = scaled_low;
    
    // Emit bits (standard renormalization)
    while encoder.high < 0x8000000000000000 || encoder.low >= 0x8000000000000000 {
        // [bit emission code, standard arithmetic coder]
    }
    
    encoder.total_bits += 1;
    Ok(())
}
```

