        let mut h = 0xcbf29ce484222325;

        h = self.mix(h, self.tick);
        h = self.mix(h, self.world.entities.len() as u64);

        for p in &self.world.pos {
            h = self.mix(h, p[0] as u64);
            h = self.mix(h, p[1] as u64);
            h = self.mix(h, p[2] as u64);
        }

        h
    }

    #[inline(always)]
    fn mix(&self, mut h: u64, v: u64) -> u64 {
        h ^= v;
        h = h.wrapping_mul(1099511628211);
        h
    }

    // ========================================================================
    // HELPERS
    // ========================================================================

    fn index(&self, id: EntityId) -> Option<usize> {
        self.world.entities.iter().position(|x| *x == id)
    }

    fn remove(&mut self, i: usize) {
        self.world.entities.swap_remove(i);
        self.world.pos.swap_remove(i);
        self.world.vel.swap_remove(i);
    }

    fn simple_hash(&self) -> u64 {
        self.world.entities.len() as u64
    }
