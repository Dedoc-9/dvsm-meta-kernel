        // ------------------------------------------------------------
        if self.config.mode == RunMode::SmokeTest {
            self.ip.log("SmokeTest tick executed");
            return Some(self.simple_hash());
        }

        // ------------------------------------------------------------
        // NOISE FILTER
        // ------------------------------------------------------------
        if !self.noise.allow(commands.len()) {
            self.ip.log("COMMAND REJECTED (NOISE LIMIT)");
            return None; // VOID STATE
        }

        // ------------------------------------------------------------
        // APPLY COMMANDS (DETERMINISTIC ORDER)
        // ------------------------------------------------------------
        for cmd in commands {
            match cmd {
                Command::Create(id) => {
                    self.world.entities.push(id);
                    self.world.pos.push([0; 3]);
                    self.world.vel.push([0; 3]);
                }

                Command::Destroy(id) => {
                    if let Some(i) = self.index(id) {
                        self.remove(i);
                    }
                }

                Command::SetPos(id, p) => {
                    if let Some(i) = self.index(id) {
                        self.world.pos[i] = p;
                    }
                }

                Command::SetVel(id, v) => {
                    if let Some(i) = self.index(id) {
                        self.world.vel[i] = v;
                    }
                }
            }
        }

        // ------------------------------------------------------------
        // PHYSICS STEP (FIXED POINT ONLY)
        // ------------------------------------------------------------
        if self.config.mode == RunMode::FullSim {
            for i in 0..self.world.entities.len() {
                self.world.pos[i][0] = fx_mul(self.world.vel[i][0], 1);
                self.world.pos[i][1] = fx_mul(self.world.vel[i][1], 1);
                self.world.pos[i][2] = fx_mul(self.world.vel[i][2], 1);
            }
        }

        // ------------------------------------------------------------
        // GHOST LAYER (OPTIONAL)
        // ------------------------------------------------------------
        self.ghost.interpolate();

        // ------------------------------------------------------------
        // FINALITY HASH (S_ECHO)
        // ------------------------------------------------------------
        Some(self.s_echo())
    }

    // ========================================================================
    // S_ECHO (DETERMINISTIC FINAL STATE)
    // ========================================================================

