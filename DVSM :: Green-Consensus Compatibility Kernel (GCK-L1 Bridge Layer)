pub struct FabricBridge;

impl FabricBridge {
    pub fn validate_quorum(peer_hashes: &[u64], target: u64, threshold: usize) -> bool {
        let count = peer_hashes.iter().filter(|h| **h == target).count();
        count >= threshold
    }
}

