pub fn green_step(server: &mut Server, input: Vec<Command>) -> u64 {
    server.buffer.extend(input);

    // NOTE:
    // No peer hashes, no rollback, no quorum.
    // Pure deterministic local tick.

    server.tick(vec![])
        .unwrap_or(server.last_hash)
}

