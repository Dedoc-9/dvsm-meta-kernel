use std::collections::VecDeque;

// ============================================================================
// FIXED POINT CORE (Q32.32)
// ============================================================================

#[derive(Copy, Clone, Debug, PartialEq)]
struct Fx(i64);

const FP_SCALE: i64 = 1 << 32;

fn fx(n: f64) -> Fx {
    Fx((n * FP_SCALE as f64) as i64)
}

fn fx_mul(a: Fx, b: Fx) -> Fx {
    Fx((a.0 * b.0) / FP_SCALE)
}

// ============================================================================
// EXECUTION MODES
// ============================================================================

#[derive(Copy, Clone, PartialEq)]
enum RuntimeMode {
    Green,      // minimal deterministic execution
    Forensic,   // full L7–L10 validation stack
