// ============================================================================
// ECS CORE
// ============================================================================

type EntityId = u32;

#[derive(Clone)]
struct Entity {
    id: EntityId,
    gen: u32,
}

#[derive(Clone)]
struct ECS {
    entities: Vec<Entity>,
    pos: Vec<[Fx; 3]>,
    vel: Vec<[Fx; 3]>,
    alive: Vec<bool>,
}

impl ECS {
    fn new() -> Self {
        Self {
            entities: vec![],
            pos: vec![],
            vel: vec![],
            alive: vec![],
        }
    }

    fn spawn(&mut self, id: EntityId) {
        self.entities.push(Entity { id, gen: 1 });
        self.pos.push([fx(0.0), fx(0.0), fx(0.0)]);
        self.vel.push([fx(0.0), fx(0.0), fx(0.0)]);
        self.alive.push(true);
    }

    fn index(&self, id: EntityId) -> Option<usize> {
        self.entities.iter().position(|e| e.id == id)
    }
}

// ============================================================================
// COMMAND STREAM (L3)
// ============================================================================

enum Command {
    Spawn(EntityId),
    Destroy(EntityId),
    SetVel(EntityId, [Fx; 3]),
}

// ============================================================================
// SNAPSHOT (ROLLBACK BUFFER)
// ============================================================================

#[derive(Clone)]
struct Snapshot {
    tick: u64,
    hash: u64,
    ecs: ECS,
}

// ============================================================================
// S_ECHO (STATE IDENTITY FUNCTION)
// ============================================================================

fn s_echo(ecs: &ECS) -> u64 {
    let mut h: u64 = 0xcbf29ce484222325;
    let prime: u64 = 1099511628211;

    for i in 0..ecs.entities.len() {
        if !ecs.alive[i] { continue; }

        let e = &ecs.entities[i];

        h ^= e.id as u64;
        h = h.wrapping_mul(prime);

        h ^= e.gen as u64;
        h = h.wrapping_mul(prime);

        for j in 0..3 {
            h ^= ecs.pos[i][j].0 as u64;
            h = h.wrapping_mul(prime);
        }
    }

    h
}

// ============================================================================
// FORENSIC LAYERS (L7–L10 PLACEHOLDERS)
// ACTIVE ONLY IN FORENSIC MODE
// ============================================================================

fn l7_merkle(_ecs: &ECS) -> u64 { 0 }
fn l8_topology(_ecs: &ECS) -> bool { true }
fn l9_spectral(_ecs: &ECS) -> f64 { 0.0 }
fn l10_migration(_prev: u64, curr: u64) -> bool { _prev == curr }

// ============================================================================
// SERVER CORE
// ============================================================================

struct Server {
    tick: u64,
    ecs: ECS,
    buffer: Vec<Command>,
    rollback: VecDeque<Snapshot>,
    last_hash: u64,
    consensus_threshold: usize,
    mode: RuntimeMode,
}

impl Server {

    fn new(mode: RuntimeMode) -> Self {
        Self {
            tick: 0,
            ecs: ECS::new(),
            buffer: vec![],
            rollback: VecDeque::with_capacity(64),
            last_hash: 0,
            consensus_threshold: 2,
            mode,
        }
    }

    // ========================================================================
    // CORE TICK (Ξ EXECUTION KERNEL)
    // ========================================================================

    fn tick(&mut self, peer_hashes: Vec<u64>) -> Option<u64> {
        self.tick += 1;

        // ----------------------------
        // APPLY COMMANDS (L3)
        // ----------------------------
        for cmd in self.buffer.drain(..) {
            match cmd {
                Command::Spawn(id) => self.ecs.spawn(id),

                Command::Destroy(id) => {
                    if let Some(i) = self.ecs.index(id) {
                        self.ecs.alive[i] = false;
                    }
                }

                Command::SetVel(id, v) => {
                    if let Some(i) = self.ecs.index(id) {
                        self.ecs.vel[i] = v;
                    }
                }
            }
        }

        // ----------------------------
        // FIXED POINT UPDATE (L1)
        // ----------------------------
        for i in 0..self.ecs.entities.len() {
            if !self.ecs.alive[i] { continue; }

            for j in 0..3 {
                self.ecs.pos[i][j].0 += self.ecs.vel[i][j].0 / 60;
            }
        }

        // ----------------------------
        // S_ECHO HASH (L5)
        // ----------------------------
        let hash = s_echo(&self.ecs);

        // ----------------------------
        // FORENSIC STACK (L7–L10)
        // ----------------------------
        if self.mode == RuntimeMode::Forensic {
            let _m = l7_merkle(&self.ecs);
            let _t = l8_topology(&self.ecs);
            let _s = l9_spectral(&self.ecs);
            let _v = l10_migration(self.last_hash, hash);

            // NOTE:
            // In full implementation, failures here would trigger rollback rejection
        }

        // ----------------------------
        // ROLLBACK BUFFER
        // ----------------------------
        if self.rollback.len() == 64 {
            self.rollback.pop_front();
        }

        self.rollback.push_back(Snapshot {
            tick: self.tick,
            hash,
            ecs: self.ecs.clone(),
        });

        // ----------------------------
        // CONSENSUS GATE
        // ----------------------------
        let matches = peer_hashes.iter().filter(|h| **h == hash).count();

        if matches < self.consensus_threshold {
            if let Some(last) = self.rollback.back() {
                self.ecs = last.ecs.clone();
                return None;
            }
        }

        self.last_hash = hash;
        Some(hash)
    }
}

// ============================================================================
// SMOKETEST ENGINE (FULL SYSTEM VALIDATION)
// ============================================================================

fn smoketest(mode: RuntimeMode) -> bool {
    let mut server = Server::new(mode);

    let mut baseline: Option<u64> = None;

    for _ in 0..128 {
        server.buffer.push(Command::Spawn(1));
        server.buffer.push(Command::SetVel(1, [fx(1.0), fx(0.0), fx(0.0)]));

        let hash = server.tick(vec![12345, 12345]);

        match (baseline, hash) {
            (None, h) => baseline = h,
            (Some(b), Some(h)) if b != h => return false,
            _ => {}
        }
    }

    true
}

