use rand_distr::{Distribution, Normal};
use rand::thread_rng;

/// anc_core.rs 
/// Irreducible Stochastic Adaptive Feedback Loop
pub struct Nucleus {
    pub weight: f64, // W_t
    pub eta: f64,    // η (Learning Rate)
}

impl Nucleus {
    pub fn new(weight: f64, eta: f64) -> Self {
        Self { weight, eta }
    }

/// Executes the adaptive inverse filtering step
pub fn step(&mut self, x_t: f64) -> FeedbackResult {
    // Model: x_hat_t = w_t · φ(x), φ(x)=1 (implicit feature)
    let x_hat_t = self.weight;

    // Inverse control output
    let y_t = -x_hat_t;

    // Residual error
    let e_t = x_t + y_t;

    // LMS / stochastic gradient update:
    // equivalent to: w_{t+1} = w_t + η (x_t - w_t)
    self.weight += self.eta * e_t;

    FeedbackResult { x_hat_t, y_t, e_t }
}

pub struct FeedbackResult {
    pub x_hat_t: f64,
    pub y_t: f64,
    pub e_t: f64,
}

fn main() {
    let mut rng = thread_rng();
    let mut core = Nucleus::new(0.0, 0.1);
    
    // x_t: Stochastic environment process
    let environment_dist = Normal::new(1.0, 0.05).unwrap();

    println!("t | x_t    | x_hat  | e_t");
    println!("--------------------------");

    for t in 0..10 {
        let x_t = environment_dist.sample(&mut rng);
        let res = core.step(x_t);
        
        println!("{:<1} | {:>6.3} | {:>6.3} | {:>6.3}", t, x_t, res.x_hat_t, res.e_t);
    }
}
use std::collections::VecDeque;
use std::marker::PhantomData;

// ============================================================================
// CORE STATE
// ============================================================================

#[derive(Debug, Clone)]
pub struct ANCState {
    /// Adaptive parameter (w_t)
    w: f64,

    /// Learning rate (η)
    eta: f64,

    /// Bounded history buffer (debug only)
    history: VecDeque<f64>,

    /// Capacity (FIXED: required for bounded logic)
    cap: usize,

    /// Compile-time intent marker (zero runtime cost)
    _semantic_lock: PhantomData<fn() -> ()>,
}

// ============================================================================
// MIND HASH (OBSERVABILITY ONLY)
// ============================================================================

#[derive(Debug)]
pub struct MindHash {
    pub value: u64,
}

impl MindHash {
    fn new() -> Self {
        Self { value: 0 }
    }

    fn update(&mut self, w: f64, e: f64) {
        let w_bits = w.to_bits() as u64;
        let e_bits = e.to_bits() as u64;

        self.value = self.value
            .wrapping_mul(1315423911)
            ^ w_bits
            ^ e_bits.rotate_left(7);
    }
}

// ============================================================================
// SYSTEM IMPLEMENTATION
// ============================================================================

impl ANCState {

    pub fn new(w: f64, eta: f64, cap: usize) -> Self {
        Self {
            w,
            eta,
            cap,
            history: VecDeque::with_capacity(cap),
            _semantic_lock: PhantomData,
        }
    }

    /// One stochastic mean-tracking step
    pub fn step(&mut self, x_t: f64, mh: &mut MindHash) -> f64 {

        // ESTIMATE: scalar predictor
        let x_hat = self.w;

        // CONTROL: inverse cancellation
        let y_t = -x_hat;

        // ERROR
        let e_t = x_t + y_t;

        // LMS / stochastic gradient step (mean tracking)
        self.w += self.eta * e_t;

        // BOUNDED MEMORY UPDATE
        self.history.push_back(x_t);
        if self.history.len() > self.cap {
            self.history.pop_front();
        }

        // OBSERVABILITY HASH (non-semantic)
        mh.update(self.w, e_t);

        e_t
    }
}
