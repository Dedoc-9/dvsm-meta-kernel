use rand_distr::{Distribution, Normal};
use rand::thread_rng;

// ============================================================================
// SECTION 1: SYSTEM DEFINITION (STATE)
// ============================================================================

/// Adaptive scalar estimator (mean-tracking parameter)
pub struct Nucleus {

    /// w_t : scalar adaptive estimate of environment mean
    pub weight: f64,

    /// η : learning rate (controls stability vs responsiveness)
    pub eta: f64,
}

impl Nucleus {

    pub fn new(weight: f64, eta: f64) -> Self {
        Self { weight, eta }
    }

    // ========================================================================
    // SECTION 2: DYNAMICS (F)
    // ========================================================================
    //
    // MATHEMATICAL MODEL (SCALAR LMS / STOCHASTIC APPROXIMATION):
    //
    //  x̂_t = w_t
    //
    //  y_t = -x̂_t
    //
    //  e_t = x_t + y_t
    //       = x_t - w_t
    //
    //  w_{t+1} = w_t + η e_t
    //           = w_t + η (x_t - w_t)
    //
    // INTERPRETATION:
    //   Online exponential tracking of the first moment of x_t
    //
    // OBJECTIVE:
    //   minimize E[(x_t - w)^2]
    //
    // ========================================================================

    /// Executes one stochastic adaptive update step
    pub fn step(&mut self, x_t: f64) -> FeedbackResult {

        // ------------------------------------------------------------
        // OBSERVATION MODEL
        // ------------------------------------------------------------
        let x_hat_t = self.weight;

        // ------------------------------------------------------------
        // CONTROL OUTPUT (inverse cancellation)
        // ------------------------------------------------------------
        let y_t = -x_hat_t;

        // ------------------------------------------------------------
        // RESIDUAL ERROR
        // ------------------------------------------------------------
        let e_t = x_t - x_hat_t;

        // ------------------------------------------------------------
        // STOCHASTIC GRADIENT UPDATE
        // ------------------------------------------------------------
        self.weight += self.eta * e_t;

        FeedbackResult {
            x_hat_t,
            y_t,
            e_t,
        }
    }
}

// ============================================================================
// SECTION 3: OBSERVATION STRUCT
// ============================================================================

pub struct FeedbackResult {
    pub x_hat_t: f64,
    pub y_t: f64,
    pub e_t: f64,
}

// ============================================================================
// SECTION 4: EXECUTION MODEL (STREAM SYSTEM)
// ============================================================================

fn main() {

    // ------------------------------------------------------------
    // STOCHASTIC ENVIRONMENT MODEL
    // ------------------------------------------------------------
    let mut rng = thread_rng();
    let environment_dist = Normal::new(1.0, 0.05).unwrap();

    // ------------------------------------------------------------
    // INITIALIZE SYSTEM
    // ------------------------------------------------------------
    let mut core = Nucleus::new(0.0, 0.1);

    println!("t | x_t    | x_hat  | e_t");
    println!("--------------------------");

    for t in 0..10 {

        let x_t = environment_dist.sample(&mut rng);
        let res = core.step(x_t);

        println!(
            "{:<1} | {:>6.3} | {:>6.3} | {:>6.3}",
            t, x_t, res.x_hat_t, res.e_t
        );
    }
}

